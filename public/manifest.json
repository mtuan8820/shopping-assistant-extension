{
  "manifest_version": 3,
  "name": "Shopping Assistant",
  "version": "1.0",
  "description": "A shopping assistant that scans product info from the current page.",
  "icons": {
    "16": "images/online-shopping.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Shopping Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["content/index.js"]
    }
  ],
  "permissions": ["sidePanel", "tabs", "activeTab", "commands", "cookies", "storage"],
  "commands":{
    "reload": {
        "suggested_key": {
            "default": "Ctrl+Shift+E"
        },
        "description": "Reload the extension"
    }
  }
}
